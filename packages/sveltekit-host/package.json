{
  "name": "@filedom/sveltekit-host",
  "version": "0.3.0",
  "license": "MIT",
  "description": "filedom SvelteKit browser-only action wrapping @filedom/core",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@filedom/core": "workspace:*",
    "@filedom/svelte": "workspace:*"
  },
  "peerDependencies": {
    "@sveltejs/kit": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "@sveltejs/kit": {
      "optional": true
    }
  },
  "devDependencies": {
    "happy-dom": "^15.11.7",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
