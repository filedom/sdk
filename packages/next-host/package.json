{
  "name": "@filedom/next-host",
  "version": "0.3.0",
  "license": "MIT",
  "description": "filedom Next.js client boundary wrapping @filedom/core",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@filedom/core": "workspace:*",
    "@filedom/react": "workspace:*"
  },
  "peerDependencies": {
    "next": ">=14.0.0",
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "happy-dom": "^15.11.7",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@types/react": "^19.0.2"
  }
}
