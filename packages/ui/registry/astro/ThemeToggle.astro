---
import { Moon, Sun } from "lucide";
import { lucideSvg } from "@/lib/cn";
import Button from "@/components/filedom/Button.astro";
import Tooltip from "@/components/filedom/Tooltip.astro";

const moon = lucideSvg(Moon);
const sun = lucideSvg(Sun);
---

<Tooltip label="Dark theme">
  <Button variant="icon" data-slot="theme-toggle" data-action="theme" data-label="Theme" title="Theme" aria-label="Theme">
    <span data-theme-icon="moon" class="contents" set:html={moon} />
    <span data-theme-icon="sun" class="contents" hidden set:html={sun} />
  </Button>
</Tooltip>
