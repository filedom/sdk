{
  "name": "@filedom/nuxt-host",
  "version": "0.3.1",
  "license": "MIT",
  "description": "filedom Nuxt client-only component wrapping @filedom/core",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@filedom/core": "workspace:*",
    "@filedom/vue": "workspace:*"
  },
  "peerDependencies": {
    "nuxt": ">=3.0.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "nuxt": {
      "optional": true
    }
  },
  "devDependencies": {
    "happy-dom": "^15.11.7",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "vue": "^3.5.13"
  }
}
