{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "domdoc://render-wire/v1",
  "title": "domdoc render wire protocol v1",
  "description": "Engine-owned immutable projection in, paint and geometry out. Web domain/editing types are not part of this schema.",
  "type": "object",
  "required": ["header", "pages"],
  "additionalProperties": false,
  "properties": {
    "header": { "$ref": "#/$defs/WireHeader" },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/ProjectionPage" }
    }
  },
  "$defs": {
    "WireHeader": {
      "type": "object",
      "required": [
        "protocolVersion",
        "schemaId",
        "requestId",
        "sessionId",
        "documentGeneration",
        "units"
      ],
      "additionalProperties": false,
      "properties": {
        "protocolVersion": { "const": 1 },
        "schemaId": { "const": "domdoc://render-wire/v1" },
        "requestId": { "type": "string", "minLength": 1 },
        "sessionId": { "type": "string", "minLength": 1 },
        "documentGeneration": { "type": "integer", "minimum": 0 },
        "units": { "const": "pt" },
        "fontEpoch": { "type": "integer", "minimum": 0 }
      }
    },
    "ProjectionPage": {
      "type": "object",
      "required": ["pageIndex", "widthPt", "heightPt", "runs"],
      "additionalProperties": false,
      "properties": {
        "pageIndex": { "type": "integer", "minimum": 0 },
        "widthPt": { "type": "number", "exclusiveMinimum": 0 },
        "heightPt": { "type": "number", "exclusiveMinimum": 0 },
        "runs": {
          "type": "array",
          "items": { "$ref": "#/$defs/StubTextRun" }
        }
      }
    },
    "StubTextRun": {
      "type": "object",
      "required": ["runId", "text", "xPt", "yPt", "fontSizePt"],
      "additionalProperties": false,
      "properties": {
        "runId": { "type": "string", "minLength": 1 },
        "text": { "type": "string" },
        "xPt": { "type": "number" },
        "yPt": { "type": "number" },
        "fontSizePt": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "RenderWireResponse": {
      "type": "object",
      "required": ["header", "geometry", "paint"],
      "additionalProperties": false,
      "properties": {
        "header": { "$ref": "#/$defs/ResponseHeader" },
        "geometry": { "$ref": "#/$defs/GeometryBundle" },
        "paint": { "$ref": "#/$defs/PaintBundle" }
      }
    },
    "ResponseHeader": {
      "type": "object",
      "required": [
        "protocolVersion",
        "schemaId",
        "requestId",
        "documentGeneration",
        "engineBuild"
      ],
      "additionalProperties": false,
      "properties": {
        "protocolVersion": { "const": 1 },
        "schemaId": { "const": "domdoc://render-wire/v1" },
        "requestId": { "type": "string" },
        "documentGeneration": { "type": "integer", "minimum": 0 },
        "engineBuild": { "type": "string" }
      }
    },
    "GeometryBundle": {
      "type": "object",
      "required": ["pages"],
      "additionalProperties": false,
      "properties": {
        "pages": {
          "type": "array",
          "items": { "$ref": "#/$defs/GeometryPage" }
        }
      }
    },
    "GeometryPage": {
      "type": "object",
      "required": ["pageIndex", "runBounds"],
      "additionalProperties": false,
      "properties": {
        "pageIndex": { "type": "integer", "minimum": 0 },
        "runBounds": {
          "type": "array",
          "items": { "$ref": "#/$defs/RectPt" }
        }
      }
    },
    "RectPt": {
      "type": "object",
      "required": ["id", "xPt", "yPt", "widthPt", "heightPt"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "xPt": { "type": "number" },
        "yPt": { "type": "number" },
        "widthPt": { "type": "number", "minimum": 0 },
        "heightPt": { "type": "number", "minimum": 0 }
      }
    },
    "PaintBundle": {
      "type": "object",
      "required": ["items"],
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/PaintItem" }
        }
      }
    },
    "PaintItem": {
      "oneOf": [
        { "$ref": "#/$defs/PaintFillRect" },
        { "$ref": "#/$defs/PaintGlyphRun" }
      ]
    },
    "PaintFillRect": {
      "type": "object",
      "required": ["kind", "pageIndex", "rect", "colorRgba"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "fillRect" },
        "pageIndex": { "type": "integer", "minimum": 0 },
        "rect": { "$ref": "#/$defs/RectPt" },
        "colorRgba": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "PaintGlyphRun": {
      "type": "object",
      "required": ["kind", "pageIndex", "runId", "glyphs"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "glyphRun" },
        "pageIndex": { "type": "integer", "minimum": 0 },
        "runId": { "type": "string" },
        "glyphs": {
          "type": "array",
          "items": { "$ref": "#/$defs/StubGlyph" }
        }
      }
    },
    "StubGlyph": {
      "type": "object",
      "required": ["char", "xPt", "yPt", "advancePt"],
      "additionalProperties": false,
      "properties": {
        "char": { "type": "string", "minLength": 1, "maxLength": 1 },
        "xPt": { "type": "number" },
        "yPt": { "type": "number" },
        "advancePt": { "type": "number", "minimum": 0 }
      }
    }
  }
}
