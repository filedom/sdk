{
  "name": "@filedom/core",
  "version": "0.3.1",
  "license": "MIT",
  "description": "filedom web SDK. The viewer talks to the filedom WebAssembly bundles. The pdf renderer is inside the pdf wasm; Office is linked inside the office bundle.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./code": {
      "types": "./dist/code-editor.d.ts",
      "import": "./dist/code-editor.js",
      "default": "./dist/code-editor.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "happy-dom": "^15.11.7",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@audio/decode-mpc": "^1.0.0",
    "@audio/decode-wavpack": "^2.0.0",
    "@cornerstonejs/codec-openjpeg": "^1.3.6",
    "@docmux/wasm": "^0.6.2",
    "@embedpdf/pdfium": "^2.15.1",
    "@file-viewer/renderer-iwork": "^3.3.3",
    "@firecrawl/anydoc-wasm": "^0.2.4",
    "@jsquash/avif": "^2.1.1",
    "@jsquash/jxl": "^1.3.0",
    "@rhwp/core": "^0.8.7",
    "@wasm-audio-decoders/flac": "^0.2.11",
    "@wasm-audio-decoders/ogg-vorbis": "^0.1.20",
    "@webtoon/psd": "^0.4.0",
    "djvu-rs": "^0.43.0",
    "epub-gen-memory": "^1.1.2",
    "exrs": "^1.0.3",
    "fzstd": "^0.1.1",
    "jspdf": "^4.2.1",
    "mediabunny": "^1.65.2",
    "odf-kit": "^0.14.5",
    "ogg-opus-decoder": "^1.7.5",
    "rtf-viewer": "^1.3.1",
    "seek-bzip": "^2.0.0",
    "shrimp-doc-viewer": "^0.5.0",
    "svg2pdf.js": "^2.9.0",
    "xz-decompress": "^0.2.3"
  }
}
