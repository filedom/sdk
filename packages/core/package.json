{
  "name": "@filedom/core",
  "version": "0.2.0",
  "license": "MIT",
  "description": "filedom web SDK. The viewer talks to the filedom WebAssembly bundles. The pdf renderer is inside the pdf wasm; Office is linked inside the office bundle.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./code": {
      "types": "./dist/code-editor.d.ts",
      "import": "./dist/code-editor.js",
      "default": "./dist/code-editor.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "happy-dom": "^15.11.7",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@embedpdf/pdfium": "^2.15.1"
  }
}
