---
import "../styles/global.css";
import FiledomProvider from "@/components/filedom/FiledomProvider.astro";
import Toolbar from "@/components/filedom/Toolbar.astro";
import ViewerShell from "@/components/filedom/ViewerShell.astro";

const bundlesBase = import.meta.env.FILEDOM_EXAMPLES_BUNDLES || "/api/bundles/0.0.1";
const toolbar = false;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>filedom Astro</title>
  </head>
  <body>
    <FiledomProvider bundlesBase={bundlesBase} toolbar={toolbar}>
      <div class="flex h-dvh min-h-0 flex-col overflow-hidden bg-background font-sans text-foreground">
        <Toolbar />
        <ViewerShell />
      </div>
    </FiledomProvider>
  </body>
</html>
