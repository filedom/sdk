---
import { Redo2, Undo2 } from "lucide";
import { lucideSvg } from "@/lib/cn";
import Button from "@/components/domdoc/Button.astro";
import FileButton from "@/components/domdoc/FileButton.astro";
import ModeSelect from "@/components/domdoc/ModeSelect.astro";
import PageStatus from "@/components/domdoc/PageStatus.astro";
import SearchBar from "@/components/domdoc/SearchBar.astro";
import Separator from "@/components/domdoc/Separator.astro";
import ThemeToggle from "@/components/domdoc/ThemeToggle.astro";
import Tooltip from "@/components/domdoc/Tooltip.astro";
import ZoomControls from "@/components/domdoc/ZoomControls.astro";

const undo = lucideSvg(Undo2);
const redo = lucideSvg(Redo2);
---

<div
  data-slot="toolbar"
  role="toolbar"
  aria-label="Document"
  class="flex h-toolbar shrink-0 items-center gap-1 border-b border-border bg-card px-2 text-card-foreground"
>
  <Tooltip label="Undo">
    <Button variant="icon" data-slot="undo" data-action="undo" data-label="Undo" title="Undo" aria-label="Undo">
      <span class="contents" set:html={undo} />
    </Button>
  </Tooltip>
  <Tooltip label="Redo">
    <Button variant="icon" data-slot="redo" data-action="redo" data-label="Redo" title="Redo" aria-label="Redo">
      <span class="contents" set:html={redo} />
    </Button>
  </Tooltip>
  <Separator orientation="vertical" />
  <FileButton />
  <Separator orientation="vertical" />
  <ZoomControls />
  <Separator orientation="vertical" />
  <SearchBar />
  <ModeSelect />
  <div class="min-w-0 flex-1"></div>
  <PageStatus />
  <ThemeToggle />
</div>
