---
import { FolderOpen } from "lucide";
import { lucideSvg } from "@/lib/cn";
import Button from "@/components/domdoc/Button.astro";
import Tooltip from "@/components/domdoc/Tooltip.astro";

const folder = lucideSvg(FolderOpen);
---

<Tooltip label="Open">
  <Button variant="icon" data-slot="file-button" data-action="open" data-label="Open" title="Open" aria-label="Open">
    <span class="contents" set:html={folder} />
  </Button>
</Tooltip>
