---
import { cn } from "@/lib/cn";

interface Props {
  class?: string;
  type?: string;
  placeholder?: string;
  disabled?: boolean;
  title?: string;
  "data-slot"?: string;
  "data-action"?: string;
  "aria-label"?: string;
}

const {
  class: className,
  type = "text",
  placeholder,
  disabled,
  title,
  "data-slot": dataSlot = "input",
  "data-action": dataAction,
  "aria-label": ariaLabel,
} = Astro.props;
---

<input
  data-slot={dataSlot}
  data-action={dataAction}
  type={type}
  placeholder={placeholder}
  disabled={disabled}
  title={title}
  aria-label={ariaLabel}
  class={cn(
    "h-8 w-full rounded-md border border-input bg-background px-2 text-sm text-foreground shadow-sm outline-none placeholder:text-muted-foreground focus-visible:ring-2 focus-visible:ring-ring disabled:opacity-40",
    className,
  )}
/>
