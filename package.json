{
  "name": "domdoc-sdk",
  "version": "0.0.6",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm --filter @domdoc/core build && pnpm -r --filter !@domdoc/core run build",
    "typecheck": "pnpm -r exec tsc --noEmit -p tsconfig.json",
    "test": "pnpm -r run test"
  },
  "engines": {
    "node": ">=20"
  }
}
